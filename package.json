  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "packs": "node scripts/build-packs.mjs",
    "test": "node scripts/build-client.mjs && node --test test/*.test.mjs",
    "export:public": "node scripts/public-release.mjs export",
    "public:check": "node scripts/public-release.mjs check",
    "public:sync": "node scripts/public-release.mjs sync"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
