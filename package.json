    "@deepseek-ai/dsh-lsp": "*",
    "@deepseek-ai/dsh-lsp-stdio": "*",
    "@deepseek-ai/dsh-tool-lsp": "*",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-experimental-worktree": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
